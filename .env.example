# Telegram API app ID from https://my.telegram.org
TG_API_ID=123456
# Telegram API hash from https://my.telegram.org
TG_API_HASH=your_api_hash_here

# Source channel (channel handle, @handle, invite link, or numeric ID)
SOURCE_CHANNEL=@source_channel
# Local archive root directory (SQLite + post folders)
LOCAL_ARCHIVE_DIR=channel-archive
# Optional JSON text-rules file for post cleanup/rewrite
# Supports keys: remove-literal, replace-literal, remove-regex, replace-regex
TEXT_RULES_FILE=
# Optional post header lines prepended at local publish time (local2dest/local2x/local2x-web/local2blogger/local2wp.com)
# ${ORIGINAL_POST_DATE} is replaced with YYYY-MM-DD
POST_AUTOPREPEND_LINE1=
POST_AUTOPREPEND_LINE2=
# Optional post footer lines appended at local publish time (local2dest/local2x/local2x-web/local2blogger/local2wp.com)
# ${ORIGINAL_POST_DATE} is replaced with YYYY-MM-DD
POST_AUTOAPPEND_LINE1=
POST_AUTOAPPEND_LINE2=
# Destination channel (channel handle, @handle, invite link, or numeric ID)
DEST_CHANNEL=@destination_channel
# local2dest only: multiple destinations (separator: ||)
# Example: https://t.me/chan1||https://t.me/chan2||https://t.me/chan3
DEST_CHANNELS=
# local2dest only: 0=run destinations one-by-one, 1=run destinations in parallel child processes
DEST_CHANNELS_ASYNC=0
# local2dest only: when DEST_CHANNELS_ASYNC=1, max concurrent destination workers
DEST_CHANNELS_MAX_CONCURRENCY=3
# local2dest only: if destination resolve fails, or resolves but is not writable,
# auto-create destination channel and continue
DEST_AUTO_CREATE=0
# local2dest auto-create: 1=public channel (requires destination channel handle from DEST_CHANNEL), 0=private
DEST_CREATE_PUBLIC=0
# local2dest auto-create: optional explicit channel title/about (blank = defaults)
DEST_CREATE_TITLE=
DEST_CREATE_ABOUT=
# local2dest auto-create: optional local image path used as created channel icon
DEST_CREATE_ICON=
# local2dest auto-create: when 1, disable reactions on newly created destination channel
DEST_CREATE_DISABLE_REACTIONS=0
# local2dest auto-create public mode:
# 1 = fail if requested handle (or increment candidates) cannot be assigned
# 0 = fall back to private channel when handle assignment fails
DEST_CREATE_FAIL_IF_HANDLE_TAKEN=1
# local2dest auto-create public mode:
# 1 = if handle is occupied, try base+1, base+2, ... until free
DEST_CREATE_CHANNEL_URI_AUTO_INCREMENT=0
DEST_CREATE_CHANNEL_URI_MAX_ATTEMPTS=50
# local2dest only: when 1, wipe destination chat history first and clear posted-state for this pair
DEST_RESET=0
# local2dest (telegram target) only: append one destination permalink to each posted unit
APPEND_DEST_PERMALINK=0
# Optional prefix text before appended permalink URL (example: "Permalink:")
APPEND_DEST_PERMALINK_TXT=
# local2web-static-js/local2bsky: optional destination channel handle used to choose Telegram permalink set
# Accepts: handle, @handle, or https://t.me/handle (used when multiple destination pairs exist)
APPEND_DEST_PERMALINK_CHANNEL=
# Optional labels used when a Telegram post is split into 2 parts due caption overflow
POST_AUTOSPLIT_TXT_HEADER_1=1/2
POST_AUTOSPLIT_TXT_FOOTER_1=
POST_AUTOSPLIT_TXT_HEADER_2=2/2

# Post mode used by local publish commands (`local2dest`, `local2x`, `local2x-web`, `local2blogger`, `local2wp.com`):
# own-post = send as your own post
# forwarded = Telegram-only mode (unsupported in DB-only local publish targets)
POST_MODE=own-post
# Telegram publishing profile:
# 0 = standard account limits
# 1 = premium-account limits (higher internal caption split threshold)
TG_PREMIUM_POSTER=0

# X (Twitter) credentials for `npm run local2x` (OAuth 1.0a user context)
# Leave blank if you do not use local2x.
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# X web automation settings for `npm run local2x-web` (non-API browser session mode)
# First run: set X_WEB_HEADLESS=0 and login once in the opened browser profile.
X_WEB_PROFILE_DIR=./.x-web-profile
X_WEB_HEADLESS=0
X_WEB_BROWSER_CHANNEL=chrome
X_WEB_STEALTH=1
X_WEB_NAV_TIMEOUT_MS=60000
X_WEB_POST_TIMEOUT_MS=120000
X_WEB_LOGIN_WAIT_MS=300000
# Max text length per X post chunk (safe range 40..280, default 260)
X_MAX_TEXT_LENGTH=260

# Blogger API settings for `npm run local2blogger` (API-only)
# Obtain these from Google Cloud OAuth credentials + OAuth Playground.
# Important: BLOGGER_CLIENT_ID/BLOGGER_CLIENT_SECRET must be from the same OAuth
# client used to mint BLOGGER_REFRESH_TOKEN, otherwise token refresh fails (401).
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
# Choose one blog locator (ID preferred). If both are set, BLOGGER_BLOG_ID is used.
BLOGGER_BLOG_ID=
BLOGGER_BLOG_URL=
# Comma-separated labels/tags added to every Blogger post.
BLOGGER_TAGS=
# local2blogger only: when 1, delete all existing posts in target blog first,
# then clear local posted-state for this source->blog pair and repost fresh.
BLOGGER_RESET=0
# local2blogger pacing between post units (falls back to WAIT_MS if empty)
BLOGGER_WAIT_MS=
# local2blogger batch pause: every N posted units, apply extra pause range.
# Set BLOGGER_BATCH_EVERY=0 to disable.
BLOGGER_BATCH_EVERY=0
BLOGGER_BATCH_PAUSE_MS=0-0
# local2blogger transient retry policy (429/5xx/network/quota-like temporary failures)
BLOGGER_RETRY_MAX=3
BLOGGER_RETRY_WAIT_MS=2500-6000

# WordPress.com API settings for `npm run local2wp.com` (API-only)
# OAuth client values come from https://developer.wordpress.com/apps/
WP_COM_CLIENT_ID=
WP_COM_CLIENT_SECRET=
# WordPress.com account username used for OAuth password grant:
WP_COM_USERNAME=
# WordPress.com Application Password (account security settings):
WP_COM_APP_PASSWORD=
# Main posting target (posts are created here)
WP_COM_MAIN_SITE_ID=
# Media host pool (comma-separated site IDs, used for uploaded media)
# Example: 12345678,23456789
WP_COM_MEDIA_SITE_IDS=
# Media distribution strategy: round-robin | fill-first
WP_COM_MEDIA_STRATEGY=round-robin
# If upload to selected media site fails, try next media site(s)
WP_COM_MEDIA_FAILOVER=1
# Optional tags/labels applied to created WP posts (comma-separated)
WP_COM_TAGS=
# Reset behavior (1 = delete existing posts on main site, delete media on media site pool, clear local posted-state, repost)
WP_COM_RESET=0
# Pacing/retry controls
WP_COM_WAIT_MS=4000-9000
WP_COM_BATCH_EVERY=15
WP_COM_BATCH_PAUSE_MS=30000-90000
WP_COM_RETRY_MAX=4
WP_COM_RETRY_WAIT_MS=4000-10000

# Bluesky API settings for `npm run local2bsky` (API-only)
BSKY_IDENTIFIER=
BSKY_APP_PASSWORD=
BSKY_SERVICE_URL=https://bsky.social
BSKY_ENABLE_VIDEO=0
BSKY_WAIT_MS=2000-6000
BSKY_RETRY_MAX=4
BSKY_RETRY_WAIT_MS=3000-9000
BSKY_POLL_MS=2000-8000
BSKY_TAGS=
BSKY_TEXT_MAX=300
BSKY_IMAGES_MAX=4
BSKY_IMAGE_MAX_BYTES=1000000
# local2bsky reset behavior:
# 1 = delete existing destination posts, clear local posted-state for pair, repost
# 0 = keep existing destination posts and use skip-on-rerun mapping
BSKY_RESET=0

# Base pacing range in milliseconds (min-max, random per step)
WAIT_MS=1200-2200
# Heartbeat interval for long-running post/download stage logs in milliseconds
HEARTBEAT_LOG_MS=8000
# Adaptive backoff gain applied after FLOOD_WAIT (bump = wait_seconds * gain)
FLOOD_BACKOFF_GAIN=0.5
# Max adaptive extra delay per stage in milliseconds
FLOOD_BACKOFF_MAX_MS=120000
# Adaptive delay decay after each successful paced step in milliseconds
FLOOD_BACKOFF_DECAY_MS=300
# Preview actions without sending messages or writing DB/archive updates
DRY_RUN=false
# Force repost even if DB says source messages were already posted
FORCE_REPOST=0
# Only process messages with ID >= START_FROM_ID (0 disables lower bound)
START_FROM_ID=0
# Only process messages with ID <= END_AT_ID (0 disables upper bound)
END_AT_ID=0
# Only process messages with date/time >= START_FROM_DATE (blank disables lower bound)
# Accepts YYYY-MM-DD or ISO datetime (example: 2026-01-15T12:00:00Z)
# If the requested start date has no posts on that day, the nearest earlier available post date is used.
START_FROM_DATE=
# Only process messages with date/time <= END_AT_DATE (blank disables upper bound)
# For YYYY-MM-DD, end of that day is used (23:59:59.999 local time)
# If the requested end date has no posts on that day, the nearest later available post date is used.
END_AT_DATE=
# Only process post units with loop index >= START_FROM_COUNT (1-based, 0 disables lower bound)
START_FROM_COUNT=0
# Only process post units with loop index <= END_AT_COUNT (1-based, 0 disables upper bound)
END_AT_COUNT=0
# Number of concurrent media downloads per post unit (1 = sequential)
DOWNLOAD_CONCURRENCY=1
# Enable src2local disk cache for scan + media (1=yes, 0=no)
# Cache is always stored as full-channel scan data (ID/date filters only affect processing, not cache scope)
FILE_CACHE_ENABLED=0
# Cache TTL in minutes (format: <number>m, example: 10080m for 7 days)
FILE_CACHE_TTL=10080m
# Cache directory path for stored scan payloads and media blobs
FILE_CACHE_PATH=./cache
# For src2local only: force cache as source and never contact source channel
USE_CACHE_AS_SOURCE=0
# local2x web extension server settings (`npm run local2x-webext-serv`)
WEBEXT_SERVER_HOST=127.0.0.1
WEBEXT_SERVER_PORT=37891
# Recommended: set a non-empty token and use it in extension popup.
WEBEXT_SERVER_TOKEN=
# Optional explicit archive DB path used by webext server.
# Leave empty to auto-use: (--local)/archive.db, else LOCAL_ARCHIVE_DIR/archive.db.
WEBEXT_ARCHIVE_DB_PATH=
# Optional webext state file path:
WEBEXT_STATE_PATH=webext/serv/state.json
# Optional force pair key; blank = auto-pick pair with most posts.
WEBEXT_PAIR_KEY=
# Optional source-message-id range for server queue (0 disables bound)
WEBEXT_START_FROM_ID=0
WEBEXT_END_AT_ID=0
# Telegram session string (required for non-interactive/reusable auth)
# If empty, script will prompt login and print a TG_SESSION value you can save here.
TG_SESSION=
# GramJS log level: none|error|warn|info|debug (info/debug for troubleshooting)
GRAMJS_LOG_LEVEL=error
# Show live download progress in TTY (files, active workers, size, speed, ETA)
SHOW_PROGRESS=0
