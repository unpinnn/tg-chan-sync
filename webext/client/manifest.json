{
  "manifest_version": 3,
  "name": "Local2X Webext Poster",
  "version": "0.1.0",
  "description": "Posts queued items from local2x-webext-serv to X from an open x.com tab.",
  "action": {
    "default_title": "Local2X Webext",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

